APP_NAME="Sheriff Security Services"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The final domain (sheriffguyana.com or sssgy.net). Vendor-pack links are signed against it.
APP_URL=https://www.sheriffguyana.com
APP_TIMEZONE=America/Guyana
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_sheriff
DB_USERNAME=u000000000_sheriff
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Hostinger mailbox (hPanel → Emails).
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@sheriffguyana.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@sheriffguyana.com
MAIL_FROM_NAME="${APP_NAME}"

# true on a temporary preview domain: "concept preview" banner + noindex. false at launch.
SHERIFF_PREVIEW=false
# Fallback for "new submission" emails. The live list is Admin → Settings → Notification emails.
SHERIFF_NOTIFY_EMAIL=

# First administrator, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
